# Copy this file to .env.supabase for the hosted Phase 1 demo. Do not commit real credentials.
NODE_ENV=development
PORT=3000
# Current hosted project and its IPv4 Session pooler (these identifiers are not credentials).
SUPABASE_PROJECT_REF=leknhhxqqehwiaxvzwnt
SUPABASE_POOLER_HOST=aws-1-eu-west-1.pooler.supabase.com
# Deployments should set the complete Session pooler URL. Keep sslmode=require.
DATABASE_URL=postgresql://postgres.leknhhxqqehwiaxvzwnt:<PASSWORD>@aws-1-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require&uselibpqcompat=true
# Local Docker is retained only for isolated development and CI tests.
TEST_DATABASE_URL=postgresql://postgres@127.0.0.1:54329/math_study_companion
# Set only when intentionally running without PostgreSQL.
# DEMO_REPOSITORY=memory

# Put these non-credential iMessage settings in ignored .env.imessage.local.
# Apple credentials remain in Messages.app and macOS Keychain.
MSC_API_URL=http://127.0.0.1:3000
MSC_IMESSAGE_RECIPIENT=student@example.com
MSC_IMESSAGE_CLI=imessage-cli
MSC_REPLY_TIMEOUT_MS=120000
MSC_IMESSAGE_POLL_MS=1000

# Telegram bot token from @BotFather, for the Telegram adapter.
TELEGRAM_BOT_TOKEN=

# Only this chat may talk to the companion. Run `pnpm telegram` with this empty
# and the runner prints the chat id it saw.
TELEGRAM_ALLOWED_CHAT_ID=

# Anthropic API key for the study agent. Without it the runners fall back to the
# deterministic scripted agent.
ANTHROPIC_API_KEY=
