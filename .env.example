# Copy to .env and fill in locally. Never commit .env (see docs/SECURITY_PRIVACY.md).

# Telegram bot token from @BotFather.
TELEGRAM_BOT_TOKEN=

# Only this chat may talk to the companion. Send /start to the bot and the
# runner prints the chat id it saw, then paste it here.
TELEGRAM_ALLOWED_CHAT_ID=

# Anthropic API key for the study agent. Without it the runner uses the
# deterministic scripted agent instead of the model.
ANTHROPIC_API_KEY=
