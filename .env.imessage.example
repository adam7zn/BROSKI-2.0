# Copy to .env.imessage.local and set the dedicated demo phone address.
# This file contains no Apple credentials; Messages.app owns the Apple session.
MSC_API_URL=http://127.0.0.1:3000
MSC_IMESSAGE_RECIPIENT=student@example.com
MSC_IMESSAGE_CLI=imessage-cli
# Optional. Omit it to generate a fresh immutable judge interaction every run,
# or pin an unused, human-readable ID for one recording.
# MSC_INTERACTION_ID=judge-recording-001
MSC_REPLY_TIMEOUT_MS=120000
MSC_IMESSAGE_POLL_MS=1000
