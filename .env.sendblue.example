# Hosted Render/PostgreSQL runtime. Keep the real file ignored and manage
# production values in Render's secret dashboard.
DATABASE_URL=
DEMO_REPOSITORY=postgresql
HOST=0.0.0.0
PORT=10000

SENDBLUE_API_BASE_URL=https://api.sendblue.co
SENDBLUE_API_KEY_ID=
SENDBLUE_API_SECRET_KEY=
SENDBLUE_FROM_NUMBER=
SENDBLUE_RECIPIENT_NUMBER=
SENDBLUE_WEBHOOK_SECRET=
INTERNAL_API_TOKEN=
MESSAGING_LIVE_ENABLED=false
CONVERSATION_AGENT_PROVIDER=deterministic
MSC_MODEL=claude-sonnet-5

# Used only by the operator-side `pnpm demo:sendblue` launch command.
MSC_API_URL=http://127.0.0.1:3000
MSC_INTERACTION_ID=

# Required only when CONVERSATION_AGENT_PROVIDER=anthropic. Explicit Anthropic
# mode fails startup when this is empty; it never falls back silently.
ANTHROPIC_API_KEY=
